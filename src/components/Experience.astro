---
const roles = [
  { type:"Operations", company:"Walmart — Costa Rica", role:"ASSET PROTECTION ASSOCIATE", dates:"February 2026 – Present", description:"Contribute through operational incident investigation, data analysis, internal systems, accurate documentation, root-cause investigation, and cross-functional problem solving.", bullets:["Monitor and investigate operational incidents using internal systems, Microsoft Excel, Power BI, and CCTV, analyzing data to identify discrepancies, patterns, and potential risks.","Analyze inventory, transaction, and treasury data to identify inconsistencies, determine possible root causes, and support corrective actions.","Document incidents and investigation findings while maintaining accurate system records for operational follow-up and reporting.","Collaborate with cross-functional teams to investigate system- and process-related discrepancies and support timely issue resolution."] },
  { type:"Support", company:"Concentrix — Costa Rica", role:"BACK OFFICE ANALYST", dates:"October 2025 – February 2026", description:"Contributed through customer case management, troubleshooting, issue investigation, documentation, escalation, internal systems, customer communication, and coordination with internal teams.", bullets:["Managed customer cases through internal systems, reviewing account and operational data to investigate service-related issues and determine appropriate resolution paths.","Provided customer support through phone and email while gathering technical and operational information required to troubleshoot and resolve reported issues.","Investigated discrepancies across customer records, shipment data, and internal systems, coordinating with specialized teams when escalation was required.","Tracked open cases and documented updates, actions, and resolution details to maintain accurate case history and consistent follow-up.","Worked across multiple internal platforms and workflows while managing concurrent cases and maintaining data accuracy and service quality."] },
  { type:"IT & Development", company:"DNAMIC", role:"Systems Support & Full Stack Developer", dates:"April 2024 – May 2025", bullets:["Investigated and resolved application, API, database, and internal system issues, identifying root causes and implementing reliable solutions.","Developed and maintained web applications and business systems using .NET, REST APIs, SQL Server, HTML, CSS, JavaScript, and Visual Basic.","Designed and optimized SQL queries, stored procedures, views, and database logic to improve data accuracy, performance, and application reliability.","Troubleshot issues across frontend, backend, API, and database layers, supporting users and minimizing operational disruptions.","Collaborated directly with clients and internal stakeholders to gather requirements, reproduce reported issues, validate solutions, and implement system improvements."], contribution:"Combined development and technical support experience to investigate issues beyond surface-level troubleshooting, analyzing application behavior, APIs, backend logic, and databases to move incidents from initial report through resolution." }
];
---
<section id="experience" class="section">
  <div class="shell">
    <div class="section-heading reveal"><span class="eyebrow">Career journey</span><h2 class="section-title">Experience across support and software</h2><p class="section-copy">Customer-facing technical work, business systems, and hands-on product development—presented as one connected technical path.</p></div>
    <div class="timeline">
      {roles.map((item) => <article class="role glass reveal"><div class="role-meta"><span class={`role-type ${item.type.toLowerCase()}`}>{item.type}</span><time>{item.dates}</time></div><div class="role-body"><h3>{item.company}</h3><p class="role-title">{item.role}</p>{item.description && <p class="role-description">{item.description}</p>}<ul>{item.bullets.map((bullet) => <li>{bullet}</li>)}</ul>{item.contribution && <p class="role-contribution"><strong>Key Contribution:</strong> {item.contribution}</p>}{item.link && <a class="inline-link" href={item.link} target="_blank" rel="noopener noreferrer">Visit site <span aria-hidden="true">↗</span></a>}</div></article>)}
    </div>
  </div>
</section>
<style>
  .timeline { position:relative; display:grid; gap:14px; max-width:980px; margin-left:auto; }
  .timeline::before { content:""; position:absolute; left:-27px; inset-block:16px; width:1px; background:linear-gradient(var(--accent),rgba(139,156,255,.03)); }
  .role { display:grid; grid-template-columns:180px 1fr; gap:32px; padding:28px; border-radius:var(--radius-md); }
  .role::after { content:""; position:absolute; left:-33px; top:32px; width:13px; height:13px; border:3px solid #0b0e15; border-radius:50%; background:#7183ee; box-shadow:0 0 0 1px rgba(139,156,255,.4); }
  .role-meta { display:flex; flex-direction:column; align-items:flex-start; gap:11px; }
  .role-meta time { color:#7f899a; font-size:.75rem; }
  .role-type { padding:5px 8px; border:1px solid var(--border); border-radius:7px; color:#aeb9d7; background:rgba(139,156,255,.06); font-size:.65rem; font-weight:700; letter-spacing:.08em; text-transform:uppercase; }
  .role-type.support { color:#9ed7be; background:rgba(75,170,124,.07); }
  .role-type.project { color:#c4acd9; background:rgba(145,95,175,.07); }
  .role-body h3 { margin:0; font-size:1.15rem; line-height:1.3; }
  .role-title { margin:3px 0 16px; color:var(--accent); font-size:.86rem; font-weight:550; }
  .role-description { margin:0 0 16px; color:#c4cbd7; font-size:.88rem; }
  .role ul { display:grid; gap:7px; margin:0; padding:0; color:var(--muted); font-size:.88rem; list-style:none; }
  .role li { position:relative; padding-left:16px; } .role li::before { content:""; position:absolute; left:0; top:.68em; width:4px; height:4px; border-radius:50%; background:#697698; }
  .role-contribution { margin:16px 0 0; color:var(--muted); font-size:.88rem; }
  .role-contribution strong { color:#c4cbd7; font-weight:650; }
  .inline-link { display:inline-block; margin-top:16px; color:#bdc7ff; font-size:.82rem; text-decoration:none; }
  @media (max-width:1050px) { .timeline { margin-left:28px; } }
  @media (max-width:650px) { .timeline { margin-left:14px; } .timeline::before { left:-14px; } .role { grid-template-columns:1fr; gap:20px; padding:22px; } .role::after { left:-20px; } .role-meta { flex-direction:row; align-items:center; justify-content:space-between; } }
</style>

---
const education = [
  { type:"Current studies", title:"Computing Engineering", institution:"Universidad Estatal a Distancia (UNED)", detail:"Bachelor’s studies — ongoing" },
  { type:"Technical degree", title:"Computer Programming", institution:"Universidad Estatal a Distancia (UNED)", detail:"Computing and Information Technology" },
  { type:"Education", title:"High School Diploma — Bachelor", institution:"Liceo Experimental Bilingüe de Belén", detail:"2023" }
];
const certifications = ["Introduction to IoT — Cisco","Introduction to Cybersecurity — Cisco","Microsoft Office Certification — Colegio Experimental Bilingüe de Belén, Costa Rica","English Language Certification — University of Costa Rica (UCR)"];
---
<section id="education" class="section">
  <div class="shell">
    <div class="section-heading reveal"><span class="eyebrow">Learning</span><h2 class="section-title">Education &amp; certifications</h2><p class="section-copy">Formal computing studies supported by foundational certifications in connected systems and security.</p></div>
    <div class="education-grid">
      <div class="education-list">{education.map((item) => <article class="education-card glass reveal"><span>{item.type}</span><h3>{item.title}</h3><p>{item.institution}</p><small>{item.detail}</small></article>)}</div>
      <aside class="certifications glass reveal"><span class="eyebrow">Certifications</span><div>{certifications.map((cert) => <p><i aria-hidden="true">✓</i>{cert}</p>)}</div></aside>
    </div>
  </div>
</section>
<style>
  .education-grid { display:grid; grid-template-columns:1.3fr .7fr; gap:16px; align-items:start; }
  .education-list { display:grid; gap:12px; }
  .education-card { padding:23px 26px; border-radius:var(--radius-md); }
  .education-card > span { color:var(--accent); font-size:.68rem; font-weight:700; letter-spacing:.1em; text-transform:uppercase; }
  .education-card h3 { margin:7px 0 2px; font-size:1.05rem; }
  .education-card p { margin:0; color:#adb6c6; font-size:.84rem; }
  .education-card small { display:block; margin-top:5px; color:#788396; }
  .certifications { padding:26px; border-radius:var(--radius-md); }
  .certifications > div { display:grid; gap:4px; margin-top:20px; }
  .certifications p { display:flex; gap:11px; margin:0; padding:13px 0; border-bottom:1px solid rgba(255,255,255,.065); color:#c4cbd7; font-size:.85rem; }
  .certifications p:last-child { border:0; }
  .certifications i { color:#91a1ff; font-style:normal; }
  @media (max-width:720px) { .education-grid { grid-template-columns:1fr; } }
</style>

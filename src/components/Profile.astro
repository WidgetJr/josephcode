---
const highlights = [
  ["01", "Technical Support", "Customer-facing issue analysis and clear, practical resolution."],
  ["02", "Systems & Troubleshooting", "Structured investigation focused on symptoms, context, and root cause."],
  ["03", "Web, API & Data", "Hands-on development across interfaces, REST services, SQL, and databases."],
  ["04", "Software Development", "Maintainable solutions shaped by business needs and reliable delivery."]
];
---
<section id="profile" class="section">
  <div class="shell profile-grid">
    <div class="section-heading reveal">
      <span class="eyebrow">Professional profile</span>
      <h2 class="section-title">Support insight.<br />Engineering mindset.</h2>
      <p class="section-copy">I work at the intersection of people, systems, and software—translating technical problems into understandable next steps and dependable solutions.</p>
    </div>
    <div class="highlight-grid">
      {highlights.map(([number, title, copy]) => <article class="highlight glass reveal"><span>{number}</span><h3>{title}</h3><p>{copy}</p></article>)}
    </div>
  </div>
</section>
<style>
  .profile-grid { display:grid; grid-template-columns:.8fr 1.2fr; gap:64px; align-items:start; }
  .section-heading { position:sticky; top:120px; }
  .highlight-grid { display:grid; grid-template-columns:1fr 1fr; gap:14px; }
  .highlight { min-height:190px; padding:24px; border-radius:var(--radius-md); }
  .highlight span { color:#7180a6; font:600 .68rem/1 ui-monospace,SFMono-Regular,monospace; }
  .highlight h3 { margin:38px 0 7px; font-size:1rem; font-weight:650; }
  .highlight p { margin:0; color:var(--muted); font-size:.87rem; }
  @media (max-width:800px) { .profile-grid { grid-template-columns:1fr; gap:12px; } .section-heading { position:static; } }
  @media (max-width:520px) { .highlight-grid { grid-template-columns:1fr; } .highlight { min-height:0; } .highlight h3 { margin-top:24px; } }
</style>

---
const groups = [
  { title: "Backend Development", items: [[".NET","dotnet.svg"],["C#",null],["Visual Basic",null],["REST APIs",null],["JWT","jsonwebtokens.svg"],["Postman","postman.svg"]] },
  { title: "Web Development", items: [["JavaScript","javascript.svg"],["TypeScript","typescript.svg"],["HTML",null],["CSS",null],["Astro","astro.svg"],["Tailwind CSS","tailwindcss.svg"],["Bootstrap","bootstrap.svg"],["jQuery","jquery.svg"]] },
  { title: "Data & Databases", items: [["SQL Server",null],["PostgreSQL","postgresql.svg"],["Supabase","supabase.svg"],["JSON","json.svg"],["Regex",null]] },
  { title: "Cloud, Tools & Delivery", items: [["Git","git.svg"],["GitHub",null],["Docker","docker.svg"],["Jira","jira.svg"],["Render",null],["Warp","warp.svg"],["Claude Code",null],["OpenAI Codex",null]] },
  { title: "IT & Support", items: [["Technical Support",null],["Systems Troubleshooting",null],["Incident Management",null],["Ticket Management",null],["Application Support",null],["Root Cause Analysis",null],["Technical Documentation",null],["IT Security Fundamentals",null]] },
  { title: "Additional / Secondary", items: [["Flutter","flutter.svg"],["Dart","dart.svg"]] }
];
---
<section id="tech-stack" class="section">
  <div class="shell">
    <div class="section-heading reveal"><span class="eyebrow">Capabilities</span><h2 class="section-title">Technical toolkit</h2><p class="section-copy">A practical stack focused on backend systems, cloud delivery, web applications, databases, and technical problem solving.</p></div>
    <div class="tech-grid">
      {groups.map((group) => <article class="tech-group glass reveal"><h3>{group.title}</h3><div class="chips">{group.items.map(([name, icon]) => <span class="chip">{icon && <img src={`/assets/techStackIcons/${icon}`} alt="" loading="lazy" />} {name}</span>)}</div></article>)}
    </div>
  </div>
</section>
<style>
  .tech-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:14px; }
  .tech-group { min-height:165px; padding:22px; border-radius:var(--radius-md); }
  .tech-group h3 { margin:0 0 18px; color:#dfe4ee; font-size:.87rem; font-weight:650; }
  .chips { display:flex; flex-wrap:wrap; gap:8px; }
  @media (max-width:850px) { .tech-grid { grid-template-columns:repeat(2,1fr); } }
  @media (max-width:520px) { .tech-grid { grid-template-columns:1fr; } .tech-group { min-height:0; } }
</style>
